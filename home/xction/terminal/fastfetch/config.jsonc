{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": ": ",
    "key": {
      "color": "green"
    }
  },

  "modules": [
    "title",
    "separator",
  
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
  
    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "cursor",
  
    "terminal",
    "terminalfont",
    "font",
  
    "cpu",
    "gpu",
  
    {
      "type": "memory"
    },
  
    {
      "type": "swap"
    },
  
    {
      "type": "disk",
      "folders": [
        "/",
        "/home"
      ]
    },
  
    {
      "type": "filesystem",
      "folders": [
        "/",
        "/home"
      ],
      "format": "{mountpoint} ({filesystem})"
    },
  
    {
      "type": "battery"
    },
  
    {
      "type": "poweradapter"
    },
  
    {
      "type": "localip"
    },
  
    "locale",
  
    "break",
  
    "colors"
  ]
}