{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "blackout",
  "author": "rokybeast",
  "themes": [
    {
      "name": "Black Out",
      "appearance": "dark",
      "style": {
        // Borders
        "border": "#0a0a0a",
        "border.variant": "#2a2a2a",
        "border.focused": "#1a1a1a",
        "border.selected": "#2a2a2a",
        "border.transparent": null,
        "border.disabled": "#fefefe",
        // Surfaces
        "elevated_surface.background": "#0a0a0a",
        "surface.background": "#0a0a0a",
        // Background
        "background": "#0a0a0a",
        // Elements and Ghost Elements
        "element.background": "#2a2a2a",
        "element.hover": "#3a3a3a",
        "element.active": null,
        "element.selected": "#2a2a2a",
        "element.disabled": null,
        "drop_target.background": "#0a0a0a",
        "ghost_element.background": null,
        "ghost_element.hover": "#2a2a2a",
        "ghost_element.active": null,
        "ghost_element.selected": "#0a0a0a",
        "ghost_element.disabled": null,
        // Text
        "text": "#ffffff",
        "text.muted": "#ffffff",
        "text.placeholder": "#ffffff",
        "text.disabled": "#0a0a0a",
        "text.accent": "#bdbdbd",
        // Icons
        "icon": null,
        "icon.muted": null,
        "icon.disabled": null,
        "icon.placeholder": null,
        "icon.accent": null,
        // Bars
        "status_bar.background": "#0a0a0a",
        "title_bar.background": "#0a0a0a",
        "title_bar.inactive_background": "#1a1a1a",
        "toolbar.background": "#1a1a1a",
        "tab_bar.background": "#0d0d0d",
        // UI Elements
        "tab.inactive_background": "#1a1a1a",
        "tab.active_background": "#2a2a2a",
        "search.match_background": "#2a5c23",
        "panel.background": "#0f0f0f",
        "panel.focused_border": "#0d0d0d",
        "pane.focused_border": null,
        "scrollbar.thumb.background": "#6a6a6a",
        "scrollbar.thumb.hover_background": "#8a8a8a",
        "scrollbar.thumb.border": null,
        "scrollbar.track.background": "#3a3a3a",
        "scrollbar.track.border": null,
        // Editor
        "editor.foreground": "#ffffff",
        "editor.background": "#0a0a0a",
        "editor.gutter.background": "#0a0a0a",
        "editor.subheader.background": "#0a0a0a",
        "editor.active_line.background": "#1a1a1a",
        "editor.highlighted_line.background": null,
        "editor.line_number": "#5a5a5a",
        "editor.active_line_number": "#ffffff",
        "editor.invisible": null,
        "editor.wrap_guide": "#1a1a1a",
        "editor.active_wrap_guide": "#1a1a1a",
        "editor.document_highlight.read_background": "#1a1a1a",
        "editor.document_highlight.write_background": "#1a1a1a",
        // Terminal
        "terminal.background": "#000000",
        "terminal.foreground": null,
        "terminal.bright_foreground": null,
        "terminal.dim_foreground": null,
        "terminal.ansi.black": "#2c2525",
        "terminal.ansi.bright_black": "#3a3232",
        "terminal.ansi.dim_black": null,
        "terminal.ansi.red": "#ff5555",
        "terminal.ansi.bright_red": "#ff5555",
        "terminal.ansi.dim_red": null,
        "terminal.ansi.green": "#53b56c",
        "terminal.ansi.bright_green": "#53b56c",
        "terminal.ansi.dim_green": null,
        "terminal.ansi.yellow": "#CC7832",
        "terminal.ansi.bright_yellow": "#F5B85A",
        "terminal.ansi.dim_yellow": null,
        "terminal.ansi.blue": "#6897BB",
        "terminal.ansi.bright_blue": "#6FAFBD",
        "terminal.ansi.dim_blue": null,
        "terminal.ansi.magenta": "#9876AA",
        "terminal.ansi.bright_magenta": "#6272a4",
        "terminal.ansi.dim_magenta": null,
        "terminal.ansi.cyan": "#85dacc",
        "terminal.ansi.bright_cyan": "#9cf1e1",
        "terminal.ansi.dim_cyan": null,
        "terminal.ansi.white": "#A9B7C6",
        "terminal.ansi.bright_white": "#ffffff",
        "terminal.ansi.dim_white": null,
        // Extra
        "link_text.hover": "#bdbdbd",
        "conflict": "#cfcfcf",
        "conflict.background": "#0a0a0a",
        "conflict.border": "#cfcfcf",
        "created": "#bdbdbd",
        "created.background": "#0a0a0a",
        "created.border": "#bdbdbd",
        "deleted": "#fefefe",
        "deleted.background": "#0a0a0a",
        "deleted.border": "#fefefe",
        // Errors, Info., etc.
        "error": "#ff5555",
        "error.background": "#a63d3d",
        "error.border": "#ff5555",
        "hidden": "#6272a4",
        "hidden.background": "#3a3f41",
        "hidden.border": "#6272a4",
        "hint": "#787878",
        "info": "#72939c",
        "info.background": "#44475a50",
        "info.border": "#f9f9f905",
        "predictive": "#787c80",
        "success": "#53b56c",
        "success.background": "#53b56c",
        "success.border": "#53b56c",
        "unreachable": "#6272a4",
        "unreachable.background": "#3a3f41",
        "unreachable.border": "#6272a4",
        "warning": "#dec184ff",
        "warning.background": "#9e7328",
        "warning.border": "#dec184",
        // External
        "players": [
          {
            "cursor": "#ffffff",
            "selection": "#5a5a5a",
            "background": "#0a0a0a"
          }
        ],
        // Syntax
        "syntax": {
          "attribute": {
            "color": "#f0be6e",
            "font_style": null,
            "font_weight": null
          },
          "comment": {
            "color": "#787c80",
            "font_style": null,
            "font_weight": 100
          },
          "constant": {
            "color": "#9876AA"
          },
          "function": { "color": "#F5B85A" },
          "method": { "color": "#B09D79" },
          "keyword": {
            "color": "#CC7832"
          },
          "number": {
            "color": "#6897BB"
          },
          "operator": {
            "color": "#CC7832",
            "font_style": null,
            "font_weight": 100
          },
          "property": {
            "color": "#A9B7C6",
            "font_style": null,
            "font_weight": null
          },
          "punctuation.bracket": {
            "color": "#A9B7C6",
            "font_style": null,
            "font_weight": null
          },
          "punctuation.delimiter": {
            "color": "#A9B7C6",
            "font_style": null,
            "font_weight": null
          },
          "punctuation": {
            "color": "#A9B7C6",
            "font_style": null,
            "font_weight": null
          },
          "string": {
            "color": "#6A8759"
          },
          "string.escape": {
            "color": "#ff9549",
            "font_style": null,
            "font_weight": null
          },
          "tag": {
            "color": "#f0be6e",
            "font_style": null,
            "font_weight": null
          },
          "type": {
            "color": "#6FAFBD",
            "font_style": null,
            "font_weight": null
          },
          "variable": {
            "color": "#A9B7C6"
          },
          "variable.special": {
            "color": "#d97934",
            "font_style": null,
            "font_weight": 300
          }
        }
      }
    }
  ]
}
