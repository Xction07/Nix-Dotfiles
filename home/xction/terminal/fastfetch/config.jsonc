{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "color": {
      "1": "blue",
      "2": "blue",
      "3": "blue",
      "4": "blue",
      "5": "blue",
      "6": "blue",
      "7": "blue",
      "8": "blue",
      "9": "blue"
    },
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": ": ",
    "color": {
      "keys": "blue",
      "output": "white",
      "separator": "white",
      "title": "white"
    }
  },

  "modules": [
    "title",
    "separator",

    "os",
    "host",
    "kernel",
    "uptime",
    "packages",

    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "cursor",

    "terminal",
    "terminalfont",
    "font",

    "cpu",
    "gpu",

    {
      "type": "memory"
    },

    {
      "type": "swap"
    },

    {
      "type": "disk",
      "folders": [
        "/",
        "/home"
      ]
    },

    {
      "type": "filesystem",
      "folders": [
        "/",
        "/home"
      ],
      "format": "{mountpoint} ({filesystem})"
    },

    {
      "type": "battery"
    },

    {
      "type": "poweradapter"
    },

    {
      "type": "localip"
    },

    "locale",

    "break",

    "colors"
  ]
}